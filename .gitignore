# Python 缓存文件
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 虚拟环境
.venv/
.venv-*/
venv/
ENV/
env/
*.egg-info/
dist/
build/

# IDE 配置
.vscode/
.idea/
*.swp
*.swo
*~

# 训练日志和输出
*.log
logs/
wandb/
runs/
checkpoints/
outputs/
unitree_rl_mjlab/logs/

# 模型文件（训练产物，通常很大）
*.pth
*.onnx
*.pt
model_*.pt

# Jupyter Notebook 缓存
.ipynb_checkpoints/

# 系统文件
Thumbs.db
.DS_Store

# 子仓库的 .git 目录（不需要嵌套 git）
G1DWAQ_Lab/.git/
unitree_rl_mjlab/.git/

# 临时文件
*.tmp
*.bak
*.orig

# MuJoCo 日志
MUJOCO_LOG.TXT

# 大型数据文件
*.pkl
*.pickle

# 预训练模型和动作数据
**/deploy/robots/*/config/policy/mimic/

# 训练视频
*.mp4
*.avi
*.mov

# 第三方依赖库（可重新下载）
**/thirdparty/onnxruntime-*/
**/simulate/mujoco/

# 演示文件
**/doc/gif/*.gif
*.gif

